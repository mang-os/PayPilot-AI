# Copy to .env and fill in real values before running docker-compose.
# Nothing here is a real secret - these are safe placeholder defaults.

# --- Database (docker-compose overrides DATABASE_URL itself; this is only
# used if you run the backend outside docker-compose) ---
DATABASE_URL=sqlite:///./dev.db

# --- Razorpay TEST MODE keys (https://dashboard.razorpay.com -> Test Mode -> API Keys) ---
# Leave blank to run in mock mode (fake order IDs, no real network calls) -
# useful for local development and for the demo script. Webhook signature
# verification is real either way.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to whatever secret you configure in the Razorpay Dashboard
# webhook settings (Settings -> Webhooks). Must match exactly.
RAZORPAY_WEBHOOK_SECRET=dev_webhook_secret_change_me

# --- LLM orchestrator (Groq OpenAI-compatible API) ---
# Leave either value blank to use the deterministic FakeLLMClient (keyword
# search, no API key needed) - this is what the demo script relies on by default.
GROQ_API_KEY=
GROQ_AI_MODEL=

# --- Buyer frontend BFF ---
# Server-only identity used by the Next.js routes for authenticated discovery,
# mandate signing, and checkout operations. Never prefix these with NEXT_PUBLIC_.
AGENT_COMMERCE_API_KEY=
AGENT_COMMERCE_AGENT_ID=
AGENT_COMMERCE_PRIVATE_KEY_HEX=

# --- Commerce rules ---
CURRENCY=INR
TAX_RATE=0.18
